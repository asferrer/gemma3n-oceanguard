# ==============================================================================
# Dockerfile Optimizado para RTX 2070 (Turing sm_75)
# ==============================================================================
# Hardware objetivo:
#   - GPU:    NVIDIA RTX 2070 (8GB GDDR6, sm_75 Turing)
#   - RAM:    16-32GB recomendado
#   - CUDA:   12.1 (estable y compatible con Turing)
#
# Expectativas de rendimiento:
#   - Tiempo de entrenamiento estimado: 15-20 horas (Gemma 3n E2B)
#   - VRAM disponible: ~7.5GB efectivos (8GB con overhead del sistema)
#   - Requiere quantizacion 4-bit (QLoRA) obligatoriamente
#   - Flash Attention compatible con Turing (sm_75 soportado)
#
# Diferencias clave vs RTX 5090:
#   - CUDA 12.1 en lugar de CUDA 12.8
#   - PyTorch 2.5.1 en lugar de 2.6.0
#   - TORCH_CUDA_ARCH_LIST="7.5" (solo Turing, sin compilaciones extra)
#   - PYTORCH_CUDA_ALLOC_CONF con max_split_size_mb:128 para fragmentacion
#   - Sin albumentations ni onnxruntime-gpu (innecesarios para este setup)
#   - Sin Jupyter (ahorro de espacio y VRAM)
#   - shm_size reducido a 8GB (vs 64GB del 5090)
# ==============================================================================

FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

# Metadata
LABEL maintainer="asanc.tech@gmail.com"
LABEL description="Gemma3N Fine-tuning optimizado para RTX 2070 Turing sm_75"
LABEL cuda_version="12.1.1"
LABEL pytorch_version="2.5.1"
LABEL version="1.0-rtx2070"

# Prevent interactive prompts during apt installs
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    # Optimizacion de memoria CUDA - critico para 8GB VRAM
    # expandable_segments: permite reutilizar bloques de memoria liberados
    # max_split_size_mb:128: reduce fragmentacion en VRAM reducida
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:128 \
    # Turing Architecture (sm_75) - compilar SOLO para esta arquitectura
    # Evita compilaciones innecesarias para sm_80/sm_86/sm_90
    TORCH_CUDA_ARCH_LIST="7.5" \
    FORCE_CUDA=1 \
    # HuggingFace cache en workspace compartido
    HF_HOME=/workspace/.cache/huggingface \
    HF_DATASETS_CACHE=/workspace/.cache/huggingface/datasets \
    TRANSFORMERS_CACHE=/workspace/.cache/huggingface/transformers

# ==============================================================================
# Instalacion de paquetes del sistema
# ==============================================================================

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools (necesarios para compilar extensiones C++)
    build-essential \
    cmake \
    ninja-build \
    # Python 3.11
    python3.11 \
    python3.11-dev \
    python3-pip \
    python3.11-venv \
    # Herramientas de desarrollo
    git \
    wget \
    curl \
    vim \
    nano \
    htop \
    tmux \
    tree \
    # Utilidades de archivo
    zip \
    unzip \
    # Monitoreo GPU (ligero, funciona con nvidia-smi)
    nvtop \
    && rm -rf /var/lib/apt/lists/*

# Configurar Python 3.11 como default del sistema
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    python -m pip install --upgrade pip setuptools wheel

# ==============================================================================
# Instalar PyTorch 2.5.1 con soporte CUDA 12.1
# ==============================================================================
# NOTA: PyTorch 2.5.1+cu121 es la version estable mas reciente que:
#   1. Soporta CUDA 12.1 (compatible con RTX 2070 Turing)
#   2. Es compatible con Unsloth para Gemma 3n
#   3. Incluye optimizaciones de memoria para VRAM limitada
# ==============================================================================

RUN pip install --no-cache-dir \
    torch==2.5.1+cu121 \
    torchvision==0.20.1+cu121 \
    torchaudio==2.5.1+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# Verificar instalacion de PyTorch (sin GPU durante build)
RUN python -c "import torch; print('PyTorch:', torch.__version__); print('CUDA:', torch.version.cuda)"

# ==============================================================================
# Instalar Unsloth con soporte CUDA 12.1 + PyTorch 2.5.1
# ==============================================================================

# Dependencias de build previas a Unsloth
RUN pip install --no-cache-dir \
    packaging \
    ninja \
    wheel

# Instalar Unsloth optimizado para cu121 + torch251
# El extra [cu121-torch251] activa las optimizaciones correctas para Turing
RUN pip install --no-cache-dir \
    "unsloth[cu121-torch251] @ git+https://github.com/unslothai/unsloth.git"

# ==============================================================================
# Instalar dependencias ML principales
# ==============================================================================

RUN pip install --no-cache-dir \
    # Ecosistema HuggingFace
    "transformers>=4.47.0,<4.52.0" \
    "datasets>=4.5.0,<5.0.0" \
    "accelerate>=1.2.0" \
    "peft>=0.13.2" \
    "trl>=0.12.0" \
    # Quantizacion - OBLIGATORIO para 8GB VRAM (QLoRA 4-bit)
    "bitsandbytes>=0.44.0" \
    # Gestion de configuracion
    pyyaml \
    omegaconf \
    # Barras de progreso y logging
    tqdm \
    rich \
    tensorboard \
    # Monitoreo GPU
    gpustat \
    # Manejo de datos
    pandas \
    pyarrow \
    # Procesamiento de imagenes (ligero, sin albumentations)
    "pillow>=10.0.0" \
    "opencv-python-headless>=4.8.0" \
    # Visualizacion
    "matplotlib>=3.8.0" \
    "scikit-learn>=1.3.0" \
    # Python interactivo (sin Jupyter para ahorrar espacio)
    ipython

# ==============================================================================
# Instalar Flash Attention 2
# ==============================================================================
# Flash Attention es compatible con Turing (sm_75) desde la version 2.x
# Si la compilacion falla, Unsloth usara attention eager como fallback
# El build puede tardar 10-20 minutos en compilar con ninja
# ==============================================================================

RUN pip install --no-cache-dir ninja packaging wheel

RUN pip install --no-cache-dir flash-attn --no-build-isolation || \
    echo "ADVERTENCIA: Flash Attention build fallo. Se usara eager attention como fallback."

# Verificar Flash Attention
RUN python -c "\
try: \
    import flash_attn; \
    print('Flash Attention', flash_attn.__version__, 'instalado correctamente'); \
except ImportError: \
    print('Flash Attention no disponible - se usara eager attention')"

# ==============================================================================
# Crear usuario unsloth (non-root por seguridad)
# ==============================================================================

RUN groupadd -r unsloth && \
    useradd -r -g unsloth -m -s /bin/bash unsloth && \
    echo "unsloth:gemma3n2025" | chpasswd && \
    usermod -aG sudo unsloth

# ==============================================================================
# Configurar estructura del workspace
# ==============================================================================

WORKDIR /workspace/project

RUN mkdir -p \
    /workspace/project/outputs \
    /workspace/project/prepared_dataset \
    /workspace/project/prepared_dataset_docker \
    /workspace/project/tools \
    /workspace/project/configs \
    /workspace/project/scripts \
    /workspace/project/models \
    /workspace/.cache/huggingface/transformers \
    /workspace/.cache/huggingface/datasets \
    /workspace/.cache/huggingface/hub

# Asignar permisos al usuario unsloth
RUN chown -R unsloth:unsloth /workspace

# Cambiar a usuario no-root
USER unsloth

# ==============================================================================
# Verificar instalaciones (checks sin GPU durante build)
# ==============================================================================

RUN python -c "import torch; print('PyTorch:', torch.__version__)" && \
    python -c "import torch; print('CUDA Version:', torch.version.cuda)" && \
    python -c "import transformers; print('Transformers:', transformers.__version__)" && \
    python -c "import trl; print('TRL:', trl.__version__)" && \
    python -c "import peft; print('PEFT:', peft.__version__)" && \
    python -c "import bitsandbytes; print('BitsAndBytes:', bitsandbytes.__version__)" && \
    echo "Todos los paquetes instalados correctamente"

# Nota: Unsloth, Flash Attention y CUDA availability requieren GPU,
# se verificaran en runtime cuando el contenedor tenga acceso a la GPU.

# ==============================================================================
# Healthcheck - Verificar GPU y compute capability sm_75
# ==============================================================================
# El assert verifica que la GPU detectada sea Turing (major=7)
# RTX 2070 reporta capability (7, 5) -> major == 7
# Si se conecta una GPU diferente, el healthcheck fallara con mensaje claro
# ==============================================================================

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "\
import torch; \
assert torch.cuda.is_available(), 'CUDA no disponible - verificar drivers y nvidia-container-toolkit'; \
cap = torch.cuda.get_device_capability(); \
assert cap[0] == 7, f'Compute capability incorrecta: {cap}, se esperaba major=7 para Turing (RTX 2070)'; \
print(f'RTX 2070 (Turing sm_75) detectada correctamente: capability={cap}')" || exit 1

# ==============================================================================
# Comando default
# ==============================================================================

CMD ["/bin/bash"]

# ==============================================================================
# Instrucciones de Build y Ejecucion
# ==============================================================================
# Build (desde el directorio raiz del proyecto):
#   docker build -f Dockerfile.rtx2070 -t gemma3n-rtx2070:latest .
#
# Run interactivo:
#   docker run --gpus all -it --rm \
#     -v $(pwd):/workspace/project \
#     --shm-size=8g \
#     gemma3n-rtx2070:latest
#
# Verificar GPU (Turing sm_75):
#   docker run --gpus all --rm gemma3n-rtx2070:latest \
#     python -c "import torch; \
#                print(torch.cuda.get_device_name(0)); \
#                print(torch.cuda.get_device_capability(0))"
#
# Via docker-compose (recomendado):
#   docker-compose -f docker-compose.rtx2070.yaml up -d
#   docker exec -it gemma3n-training-rtx2070 bash
# ==============================================================================
